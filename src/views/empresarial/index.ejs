<%- include('../partials/head', { titulo: titulo }) %>

<body>
    <%- include('../partials/navigation', { activo: 'empresa' }) %>

    <%- include('partials/menu', { activo: 'panel' }) %>

    <main class="emp-main">

        <section class="emp-contenido">
            <p class="emp-etiqueta"><%= locals.empresaActual ? empresaActual.nombre : 'Mi empresa' %></p>

            <div class="emp-titulo-fila">
                <div>
                    <h1><%= saludo %></h1>
                    <p class="emp-ayuda">Este es el resumen de tu reclutamiento.</p>
                </div>
                <div class="emp-acciones">
                    <a class="emp-btn" href="/empresarial/postulaciones">👥 Ver postulaciones</a>
                    <a class="emp-btn emp-btn-primario" href="/empresarial/publicar">+ Publicar empleo</a>
                </div>
            </div>

            <div class="emp-kpis">
                <div class="emp-tarjeta emp-kpi">
                    <span class="emp-kpi-icono azul">💼</span>
                    <div>
                        <small>Vacantes activas</small>
                        <strong><%= indicadores.vacantesActivas %></strong>
                        <em>+<%= indicadores.vacantesMes %> este mes</em>
                    </div>
                </div>
                <div class="emp-tarjeta emp-kpi">
                    <span class="emp-kpi-icono verde">👥</span>
                    <div>
                        <small>Postulaciones</small>
                        <strong><%= indicadores.postulaciones %></strong>
                        <em>+<%= indicadores.postulacionesMes %> últimos 30 días</em>
                    </div>
                </div>
                <div class="emp-tarjeta emp-kpi">
                    <span class="emp-kpi-icono amarillo">👁</span>
                    <div>
                        <small>Visualizaciones</small>
                        <strong><%= indicadores.visualizaciones.toLocaleString('es') %></strong>
                        <em class="neutro">en todas las vacantes</em>
                    </div>
                </div>
                <div class="emp-tarjeta emp-kpi">
                    <span class="emp-kpi-icono morado">💬</span>
                    <div>
                        <small>Tasa de respuesta</small>
                        <strong><%= indicadores.tasaRespuesta %>%</strong>
                        <em class="<%= indicadores.tasaRespuesta >= 50 ? '' : 'baja' %>">postulaciones revisadas</em>
                    </div>
                </div>
            </div>

            <div class="emp-panel-fila">
                <div class="emp-tarjeta emp-bloque">
                    <div class="emp-titulo-fila">
                        <h3>Postulaciones <%= rango === 7 ? 'por día' : 'por semana' %></h3>
                        <nav class="emp-segmentos">
                            <% [7, 30, 90].forEach(r => { %>
                                <a class="<%= rango === r ? 'activo' : '' %>" href="/empresarial?rango=<%= r %>"><%= r %> días</a>
                            <% }) %>
                        </nav>
                    </div>

                    <div class="emp-grafica">
                        <% grafica.forEach((barra, i) => { %>
                            <div class="emp-grafica-col" title="<%= barra.total %> postulaciones">
                                <span class="emp-grafica-valor"><%= barra.total %></span>
                                <div class="emp-grafica-barra <%= i === grafica.length - 1 ? 'actual' : '' %>" style="height: <%= Math.max(barra.altura, 3) %>%;"></div>
                                <small><%= barra.etiqueta %></small>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="emp-tarjeta emp-bloque">
                    <h3>Actividad reciente</h3>
                    <% if (actividad.length === 0) { %>
                        <p class="emp-ayuda">Todavía no hay actividad.</p>
                    <% } %>
                    <ul class="emp-actividad">
                        <% actividad.forEach(a => { %>
                            <li>
                                <% if (a.tipo === 'cierre') { %>
                                    <span class="emp-avatar emp-avatar-alerta">⚠</span>
                                    <div>
                                        La vacante <a href="/empresarial/postulaciones?vacante=<%= a.vacanteId %>"><strong><%= a.vacante %></strong></a>
                                        <%= a.dias === 0 ? 'cierra hoy' : a.dias === 1 ? 'cierra mañana' : `cierra en ${a.dias} días` %><br>
                                        <small>Recordatorio</small>
                                    </div>
                                <% } else if (a.tipo === 'nota') { %>
                                    <span class="emp-avatar">📝</span>
                                    <div>
                                        <strong><%= a.nombre %></strong> agregó una nota a
                                        <a href="/empresarial/candidatos/<%= a.postulacionId %>#notas"><%= a.candidato %></a><br>
                                        <small><%= haceCuanto(a.fecha) %></small>
                                    </div>
                                <% } else { %>
                                    <span class="emp-avatar"><%= a.nombre.split(' ').map(n => n.charAt(0)).join('').slice(0, 2) %></span>
                                    <div>
                                        <a href="/empresarial/candidatos/<%= a.postulacionId %>"><strong><%= a.nombre %></strong></a>
                                        se postuló a <%= a.vacante %>
                                        <% if (a.estado !== 'Nuevo') { %>
                                            <span class="emp-estado emp-estado-<%= a.estado.toLowerCase() %>"><%= a.estado %></span>
                                        <% } %><br>
                                        <small><%= haceCuanto(a.fecha) %></small>
                                    </div>
                                <% } %>
                            </li>
                        <% }) %>
                    </ul>
                </div>
            </div>

            <div class="emp-tarjeta">
                <div class="emp-titulo-fila emp-tabla-titulo">
                    <h3>Mis vacantes activas</h3>
                    <a href="/empresarial/vacantes?estado=Activa">Ver todas (<%= totalVacantesActivas %>) →</a>
                </div>

                <% if (vacantes.length === 0) { %>
                    <p class="emp-vacio">No tienes vacantes activas. <a href="/empresarial/publicar">Publica una</a>.</p>
                <% } else { %>
                    <table class="emp-tabla">
                        <thead>
                            <tr>
                                <th>Vacante</th>
                                <th>Empresa</th>
                                <th>Publicada</th>
                                <th>Postulantes</th>
                                <th>Vistas</th>
                                <th>Estado</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% vacantes.forEach(v => { %>
                                <tr>
                                    <td><a class="emp-link-fila" href="/empresarial/postulaciones?vacante=<%= v.id %>"><strong><%= v.titulo %></strong></a></td>
                                    <td><%= v.empresa.nombre %></td>
                                    <td><%= formatoFecha(v.fechaPublicacion) %></td>
                                    <td><%= v.totalPostulantes %></td>
                                    <td><%= v.vistas.toLocaleString('es') %></td>
                                    <td>
                                        <% if (v.porCerrar) { %>
                                            <span class="emp-estado emp-estado-pendiente">Por cerrar</span>
                                        <% } else { %>
                                            <span class="emp-estado emp-estado-activa">Activa</span>
                                        <% } %>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                <% } %>
            </div>
        </section>

    </main>

    <%- include('../partials/footer') %>
