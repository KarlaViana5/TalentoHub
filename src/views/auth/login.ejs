<%- include('../partials/head', { titulo: titulo }) %>
<link rel="stylesheet" href="/css/auth.css">

<body class="auth-body">
    <main class="auth-contenedor auth-contenedor-login">
        <aside class="auth-panel-brand">
            <a href="/" class="auth-panel-logo">
                <span class="auth-panel-logo-icon"><i class="fa-solid fa-briefcase" aria-hidden="true"></i></span>
                Talento<span>Hub</span>
            </a>
            <div class="auth-panel-copy">
                <span class="auth-panel-etiqueta">Tu siguiente oportunidad</span>
                <h1>Conecta.<br>Crece.<br><strong>Avanza.</strong></h1>
                <p>Encuentra oportunidades, desarrolla tus habilidades y construye tu futuro profesional en un solo lugar.</p>
            </div>
            <span class="auth-panel-footer">TalentoHub · Plataforma profesional</span>
        </aside>

        <section class="auth-card">
            <div class="auth-encabezado">
                <span class="auth-etiqueta">Bienvenido de nuevo</span>
            </div>
            <h2>Iniciar sesión</h2>
            <p class="auth-subtitulo">
                Accede a tu cuenta para continuar.
            </p>

            <% if (aviso) { %>
                <div class="auth-alerta aviso">ℹ <%= aviso %></div>
            <% } %>
            <% if (mensaje) { %>
                <div class="auth-alerta exito">✓ <%= mensaje %></div>
            <% } %>
            <% if (error) { %>
                <div class="auth-alerta error">⚠ <%= error %></div>
            <% } %>

            <form class="auth-form" method="post" action="/auth/login">
                <input type="hidden" name="volver" value="<%= volver %>">

                <div class="auth-campo">
                    <label for="correo">Correo electrónico</label>
                    <input
                        type="email"
                        id="correo"
                        name="correo"
                        value="<%= correoPrevio %>"
                        placeholder="ejemplo@correo.com"
                        required
                        autocomplete="email"
                    >
                </div>

                <div class="auth-campo">
                    <label for="clave">Contraseña</label>
                    <input
                        type="password"
                        id="clave"
                        name="clave"
                        placeholder="Ingresa tu contraseña"
                        required
                        autocomplete="current-password"
                    >
                </div>

                <button type="submit" class="auth-btn auth-btn-primario auth-btn-ancho">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    Iniciar sesión
                </button>
            </form>

            <div class="auth-registro">
                ¿Aún no tienes cuenta en TalentoHub?
                <div class="auth-registro-enlaces">
                    <a href="/auth/registro?rol=candidato" class="auth-btn auth-btn-secundario">
                        <i class="fa-solid fa-user" aria-hidden="true"></i> Crear cuenta
                    </a>
                    <a href="/auth/registro?rol=empresa" class="auth-btn auth-btn-secundario">
                        <i class="fa-solid fa-building" aria-hidden="true"></i> Registrar empresa
                    </a>
                </div>
            </div>
        </section>
    </main>
</body>
</html>
