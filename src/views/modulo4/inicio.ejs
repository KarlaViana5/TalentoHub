<%- include('../partials/head', { titulo }) %>
<body class="modulo4">
<link rel="stylesheet" href="/css/modulo4.css">
<a class="salto" href="#contenido">Ir al contenido</a>
<header class="barra-comunidad">
    <a class="marca" href="/">TalentoHub</a>
    <nav aria-label="Navegación principal">
        <a href="/busqueda">Empleos</a>
        <a href="/recursos">Recursos</a>
        <a href="/foros">Foros</a>
        <% if (typeof usuario !== 'undefined' && usuario?.rol === 'admin') { %>
            <a href="/administrativo">Administración</a>
        <% } %>
    </nav>
    <% if (typeof usuario !== 'undefined' && usuario) { %>
        <form method="post" action="/foros/salir">
            <input type="hidden" name="_csrf" value="<%= csrf %>">
            <button class="secundario" type="submit">Salir · <%= usuario.nombre %></button>
        </form>
    <% } else { %>
        <a href="/foros/ingresar">Ingresar</a>
    <% } %>
</header>
<main id="contenido" class="contenedor-comunidad">
