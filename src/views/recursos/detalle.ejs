
<!-- src/views/recursos/detalle.ejs -->

<%- include('../partials/head', { titulo: titulo }) %>

<link rel="stylesheet" href="/css/busqueda.css">
<link rel="stylesheet" href="/css/recursos.css">
<link rel="stylesheet" href="/css/detalle-recursos.css">

<body>

    <%- include('../partials/navigation', { activo: 'recursos' }) %>


    <main class="detalle-recursos-container">

        <!-- RUTA DE NAVEGACIÓN -->
        <div class="detalle-migas">

            <a href="/">Inicio</a>

            <i class="fa-solid fa-chevron-right"></i>

            <a href="/recursos">Recursos</a>

            <i class="fa-solid fa-chevron-right"></i>

            <span>Detalle del recurso</span>

        </div>


        <!-- ENCABEZADO DEL RECURSO -->
        <section class="detalle-hero">

            <div class="detalle-categoria">

                <span>
                    <%= recurso.categoria %>
                </span>

                <span class="detalle-tipo">

                    <% if (recurso.tipo === 'video') { %>
                        <i class="fa-solid fa-circle-play"></i>
                        Video
                    <% } else if (recurso.tipo === 'tutorial') { %>
                        <i class="fa-solid fa-graduation-cap"></i>
                        Tutorial
                    <% } else if (recurso.tipo === 'audio') { %>
                        <i class="fa-solid fa-headphones"></i>
                        Audio
                    <% } else { %>
                        <i class="fa-solid fa-book-open"></i>
                        Artículo
                    <% } %>

                </span>

                <% if (recurso.destacado) { %>

                    <span class="detalle-etiqueta-destacado">
                        <i class="fa-solid fa-star"></i>
                        Destacado
                    </span>

                <% } %>

            </div>


            <h1><%= recurso.titulo %></h1>

            <p class="detalle-resumen">
                <%= recurso.resumen || 'Conoce más sobre este tema y fortalece tu desarrollo profesional.' %>
            </p>


            <div class="detalle-metadatos">

                <span>
                    <i class="fa-solid fa-user"></i>
                    <%= recurso.autor || 'Equipo TalentoHub' %>
                </span>

                <span>
                    <i class="fa-regular fa-calendar"></i>

                    <%= new Date(recurso.fechaPublicacion).toLocaleDateString('es-SV', {
                        day: '2-digit',
                        month: 'long',
                        year: 'numeric'
                    }) %>
                </span>

                <% if (recurso.tiempoLectura) { %>

                    <span>
                        <i class="fa-regular fa-clock"></i>
                        <%= recurso.tiempoLectura %> minutos de lectura
                    </span>

                <% } %>

            </div>

        </section>


        <!-- IMAGEN DEL RECURSO -->
        <% if (recurso.imagenUrl) { %>

            <div class="detalle-imagen">
                <img
                    src="<%= recurso.imagenUrl %>"
                    alt="<%= recurso.titulo %>"
                >
            </div>

        <% } %>


        <!-- CONTENIDO PRINCIPAL -->
        <div class="detalle-layout">


            <!-- CONTENIDO -->
            <article class="detalle-contenido">

                <div class="detalle-contenido-encabezado">

                    <span class="detalle-contenido-etiqueta">
                        CONTENIDO DEL RECURSO
                    </span>

                    <button
                        type="button"
                        class="detalle-compartir"
                        id="btnCompartir"
                    >
                        <i class="fa-solid fa-share-nodes"></i>
                        Compartir
                    </button>

                </div>

                <% if (recurso.archivoUrl) { %>
                    <aside class="detalle-material-destacado">
                        <div>
                            <strong><i class="fa-solid fa-paperclip" aria-hidden="true"></i> Material complementario</strong>
                            <p>Abre el archivo o recurso multimedia asociado.</p>
                        </div>
                        <a href="<%= recurso.archivoUrl %>" target="_blank" rel="noopener" class="th-btn th-btn-secondary">
                            Abrir material
                        </a>
                    </aside>
                <% } %>


                <% if (recurso.secciones && recurso.secciones.length > 0) { %>

                    <div class="detalle-secciones">

                        <% recurso.secciones.forEach((seccion, index) => { %>

                            <section
                                class="detalle-seccion"
                                id="seccion-<%= seccion.id %>"
                            >

                                <h2>
                                    <%= seccion.titulo %>
                                </h2>

                                <div class="detalle-texto">

                                    <%= seccion.contenido %>

                                </div>

                            </section>

                        <% }) %>

                    </div>

                <% } else { %>

                    <div class="detalle-sin-contenido">

                        <i class="fa-solid fa-file-circle-info"></i>

                        <h2>Contenido próximamente</h2>

                        <p>
                            Este recurso todavía no tiene secciones de
                            contenido registradas. Estamos preparando
                            información para ti.
                        </p>

                    </div>

                <% } %>


                <div class="detalle-volver">

                    <a href="/recursos">
                        <i class="fa-solid fa-arrow-left"></i>
                        Volver a los recursos
                    </a>

                </div>

            </article>


            <!-- BARRA LATERAL -->
            <aside class="detalle-sidebar">


                <!-- ÍNDICE -->
                <div class="detalle-sidebar-card">

                    <h3>
                        <i class="fa-solid fa-list"></i>
                        En este recurso
                    </h3>

                    <% if (recurso.secciones && recurso.secciones.length > 0) { %>

                        <ul class="detalle-indice">

                            <% recurso.secciones.forEach(seccion => { %>

                                <li>
                                    <a href="#seccion-<%= seccion.id %>">
                                        <%= seccion.titulo %>
                                    </a>
                                </li>

                            <% }) %>

                        </ul>

                    <% } else { %>

                        <p class="detalle-indice-vacio">
                            El índice estará disponible cuando se agregue contenido.
                        </p>

                    <% } %>

                </div>


                <!-- INFORMACIÓN -->
                <div class="detalle-sidebar-card detalle-info-card">

                    <h3>
                        <i class="fa-solid fa-circle-info"></i>
                        Información
                    </h3>

                    <div class="detalle-info-item">

                        <span>Autor</span>

                        <strong>
                            <%= recurso.autor || 'Equipo TalentoHub' %>
                        </strong>

                    </div>

                    <div class="detalle-info-item">

                        <span>Categoría</span>

                        <strong>
                            <%= recurso.categoria %>
                        </strong>

                    </div>

                    <div class="detalle-info-item">

                        <span>Tipo</span>

                        <strong>
                            <%= recurso.tipo %>
                        </strong>

                    </div>

                    <% if (recurso.tiempoLectura) { %>

                        <div class="detalle-info-item">

                            <span>Tiempo de lectura</span>

                            <strong>
                                <%= recurso.tiempoLectura %> minutos
                            </strong>

                        </div>

                    <% } %>

                </div>


                <!-- INVITACIÓN -->
                <div class="detalle-sidebar-ayuda">

                    <i class="fa-solid fa-lightbulb"></i>

                    <h3>¡Sigue aprendiendo!</h3>

                    <p>
                        Explora otros recursos y continúa desarrollando
                        tus habilidades profesionales.
                    </p>

                    <a href="/recursos">
                        Explorar recursos
                    </a>

                </div>


            </aside>

        </div>


        <!-- RECURSOS RELACIONADOS -->
        <% if (recursosRelacionados && recursosRelacionados.length > 0) { %>

            <section class="detalle-relacionados">

                <div class="detalle-relacionados-encabezado">

                    <div>
                        <span>CONTINÚA APRENDIENDO</span>
                        <h2>Recursos relacionados</h2>
                        <p>Otros materiales que podrían interesarte.</p>
                    </div>

                    <a href="/recursos">
                        Ver todos
                        <i class="fa-solid fa-arrow-right"></i>
                    </a>

                </div>


                <div class="recursos-grid">

                    <% recursosRelacionados.forEach(relacionado => { %>

                        <article class="recurso-card">

                            <div class="recurso-imagen">

                                <% if (relacionado.imagenUrl) { %>

                                    <img
                                        src="<%= relacionado.imagenUrl %>"
                                        alt="<%= relacionado.titulo %>"
                                    >

                                <% } else { %>

                                    <div class="recurso-imagen-placeholder">
                                        <i class="fa-solid fa-book-open"></i>
                                    </div>

                                <% } %>

                            </div>


                            <div class="recurso-contenido">

                                <span class="recurso-categoria">
                                    <%= relacionado.categoria %>
                                </span>

                                <h3>
                                    <%= relacionado.titulo %>
                                </h3>

                                <p class="recurso-resumen">
                                    <%= relacionado.resumen || 'Descubre este recurso profesional.' %>
                                </p>

                                <div class="recurso-footer">

                                    <span class="recurso-fecha">
                                        <i class="fa-solid fa-user"></i>
                                        <%= relacionado.autor || 'TalentoHub' %>
                                    </span>

                                    <a
                                        href="/recursos/<%= relacionado.id %>"
                                        class="btn-ver-recurso"
                                    >
                                        Leer más
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </a>

                                </div>

                            </div>

                        </article>

                    <% }) %>

                </div>

            </section>

        <% } %>

    </main>


    <%- include('../partials/footer') %>


    <!-- COMPARTIR RECURSO -->
    <script>

        const btnCompartir = document.getElementById('btnCompartir');

        if (btnCompartir) {

            btnCompartir.addEventListener('click', async () => {

                const datos = {
                    title: document.title,
                    text: '<%= recurso.titulo.replace(/'/g, "\\'") %>',
                    url: window.location.href
                };

                try {

                    if (navigator.share) {

                        await navigator.share(datos);

                    } else if (navigator.clipboard) {

                        await navigator.clipboard.writeText(datos.url);

                        alert('¡Enlace copiado correctamente!');

                    } else {

                        alert('Tu navegador no permite compartir desde esta página.');

                    }

                } catch (error) {

                    if (error.name !== 'AbortError') {
                        console.error('Error al compartir:', error);
                    }

                }

            });

        }

    </script>
<div class="barra-progreso-lectura"
     role="progressbar"
     aria-label="Progreso de lectura"
     aria-valuemin="0"
     aria-valuemax="100"
     aria-valuenow="0">
    <div class="barra-progreso-lectura__avance"></div>
</div>
<script>
    document.addEventListener('DOMContentLoaded', () => {

        const barra = document.querySelector(
            '.barra-progreso-lectura'
        );

        const avance = document.querySelector(
            '.barra-progreso-lectura__avance'
        );

        if (!barra || !avance) {
            return;
        }

        function actualizarProgreso() {

            const alturaTotal =
                document.documentElement.scrollHeight;

            const alturaVisible =
                window.innerHeight;

            const desplazamiento =
                window.scrollY;

            const recorrido =
                alturaTotal - alturaVisible;

            let porcentaje = 0;

            if (recorrido > 0) {
                porcentaje =
                    (desplazamiento / recorrido) * 100;
            } else {
                porcentaje = 100;
            }

            porcentaje = Math.min(
                100,
                Math.max(0, porcentaje)
            );

            avance.style.width = porcentaje + '%';

            barra.setAttribute(
                'aria-valuenow',
                Math.round(porcentaje)
            );
        }

        window.addEventListener(
            'scroll',
            actualizarProgreso,
            { passive: true }
        );

        window.addEventListener(
            'resize',
            actualizarProgreso
        );

        actualizarProgreso();
    });
</script>
</body>
</html>
