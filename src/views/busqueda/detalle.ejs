
<!-- src/views/busqueda/detalle.ejs -->

<%
    const responsabilidades = Array.isArray(vacante.responsabilidades)
        ? vacante.responsabilidades : [];

    const requisitos = Array.isArray(vacante.requisitos)
        ? vacante.requisitos : [];

    const beneficios = Array.isArray(vacante.beneficios)
        ? vacante.beneficios : [];

    const salarioMinimo = vacante.salarioMinimo != null
        ? Number(vacante.salarioMinimo) : null;

    const salarioMaximo = vacante.salarioMaximo != null
        ? Number(vacante.salarioMaximo) : null;

    const fecha = vacante.fechaPublicacion
        ? new Date(vacante.fechaPublicacion).toLocaleDateString('es-SV', {
            day: 'numeric',
            month: 'long',
            year: 'numeric'
        })
        : 'No especificada';
%>

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title><%= titulo %> | TalentoHub</title>

    <link rel="stylesheet" href="/css/busqueda.css">
    <link rel="stylesheet" href="/css/detalle.css">
    <link rel="stylesheet" href="/css/navigation.css">
    <link rel="stylesheet" href="/css/design-system.css">
    <%- include('../partials/csrf-head') %>
</head>

<body class="th-public th-public--empleo">
    <a class="th-ui-skip" href="#contenido-principal">Saltar al contenido</a>

    <%- include('../partials/navigation', { activo: 'busqueda' }) %>


    <!-- =====================================
         CONTENIDO PRINCIPAL
    ====================================== -->

    <main class="detail-page" id="contenido-principal" tabindex="-1">

        <% if (typeof mensaje !== 'undefined' && mensaje) { %>
            <div role="status" style="background: #ecfdf5; border: 1px solid #a7f3d0; color: #065f46; padding: 14px 18px; border-radius: 12px; margin-bottom: 18px; font-weight: 600;">
                ✓ <%= mensaje %>
                <% if (locals.usuarioActual && usuarioActual.rol === 'candidato') { %>
                    — <a href="/candidato" style="color: #047857; text-decoration: underline;">Ver mis postulaciones →</a>
                <% } %>
            </div>
        <% } %>

        <% if (typeof error !== 'undefined' && error) { %>
            <div role="alert" style="background: #fef2f2; border: 1px solid #fecaca; color: #991b1b; padding: 14px 18px; border-radius: 12px; margin-bottom: 18px; font-weight: 600;">
                ⚠ <%= error %>
            </div>
        <% } %>

        <!-- RUTA DE NAVEGACIÓN -->

        <div class="breadcrumb" role="navigation" aria-label="Ruta de navegación">
            <a href="/">Inicio</a>
            <span>/</span>
            <a href="/busqueda">Vacantes</a>
            <span>/</span>
            <strong><%= vacante.titulo %></strong>
        </div>


        <!-- =====================================
             ENCABEZADO DEL EMPLEO
        ====================================== -->

        <section class="detail-hero">

            <div class="detail-company-logo">

                <% if (vacante.logoEmpresa) { %>

                    <img
                        src="<%= vacante.logoEmpresa %>"
                        alt="Logo de <%= vacante.empresa %>"
                    >

                <% } else { %>

                    <span>
                        <%= vacante.empresa.charAt(0).toUpperCase() %>
                    </span>

                <% } %>

            </div>


            <div class="detail-title-content">

                <span class="detail-sector">
                    <%= vacante.sector || 'Oportunidad laboral' %>
                </span>

                <h1><%= vacante.titulo %></h1>

                <p class="detail-company-name">
                    <%= vacante.empresa %>
                </p>

                <div class="detail-meta">

                    <span>⌖ <%= vacante.ubicacion || 'Ubicación no especificada' %></span>

                    <span>◷ <%= vacante.modalidad || 'Modalidad no especificada' %></span>

                    <span>▤ <%= vacante.tipoContrato || 'Contrato no especificado' %></span>

                </div>

            </div>


            <div class="detail-publication">
                <span class="publication-dot"></span>
                Vacante publicada
            </div>

        </section>


        <!-- =====================================
             INFORMACIÓN Y CONTENIDO
        ====================================== -->

        <div class="detail-layout">


            <!-- COLUMNA PRINCIPAL -->

            <div class="detail-main-column">


                <!-- DESCRIPCIÓN -->

                <section class="detail-card">

                    <div class="detail-section-heading">
                        <span class="section-icon">▤</span>

                        <div>
                            <h2>Descripción del empleo</h2>
                            <p>Conoce más sobre esta oportunidad</p>
                        </div>
                    </div>

                    <div class="detail-text">
                        <% if (vacante.descripcion) { %>

                            <p><%= vacante.descripcion %></p>

                        <% } else { %>

                            <p>
                                La empresa no ha proporcionado una descripción
                                adicional para esta vacante.
                            </p>

                        <% } %>
                    </div>

                </section>


                <!-- RESPONSABILIDADES -->

                <section class="detail-card">

                    <div class="detail-section-heading">
                        <span class="section-icon">✓</span>

                        <div>
                            <h2>Responsabilidades</h2>
                            <p>Principales actividades del puesto</p>
                        </div>
                    </div>

                    <% if (responsabilidades.length > 0) { %>

                        <ul class="detail-list responsibility-list">

                            <% responsabilidades.forEach(responsabilidad => { %>

                                <li>
                                    <span class="list-check">✓</span>
                                    <span><%= responsabilidad %></span>
                                </li>

                            <% }) %>

                        </ul>

                    <% } else { %>

                        <p class="detail-empty">
                            No se han especificado responsabilidades.
                        </p>

                    <% } %>

                </section>


                <!-- REQUISITOS -->

                <section class="detail-card">

                    <div class="detail-section-heading">
                        <span class="section-icon">✧</span>

                        <div>
                            <h2>Requisitos del puesto</h2>
                            <p>Conocimientos y habilidades necesarios</p>
                        </div>
                    </div>

                    <% if (requisitos.length > 0) { %>

                        <ul class="detail-list requirement-list">

                            <% requisitos.forEach(requisito => { %>

                                <li>
                                    <span class="list-bullet">•</span>
                                    <span><%= requisito %></span>
                                </li>

                            <% }) %>

                        </ul>

                    <% } else { %>

                        <p class="detail-empty">
                            No se han especificado requisitos.
                        </p>

                    <% } %>

                </section>


                <!-- BENEFICIOS -->

                <section class="detail-card">

                    <div class="detail-section-heading">
                        <span class="section-icon benefit-icon">♡</span>

                        <div>
                            <h2>Beneficios</h2>
                            <p>Lo que ofrece esta oportunidad</p>
                        </div>
                    </div>

                    <% if (beneficios.length > 0) { %>

                        <div class="benefits-grid">

                            <% beneficios.forEach(beneficio => { %>

                                <div class="benefit-item">
                                    <span>✓</span>
                                    <p><%= beneficio %></p>
                                </div>

                            <% }) %>

                        </div>

                    <% } else { %>

                        <p class="detail-empty">
                            No se han especificado beneficios.
                        </p>

                    <% } %>

                </section>


                <!-- INFORMACIÓN DE CONTACTO -->

                <section class="detail-card contact-card">

                    <div class="detail-section-heading">
                        <span class="section-icon">✉</span>

                        <div>
                            <h2>Información de contacto</h2>
                            <p>Datos de la persona encargada del proceso</p>
                        </div>
                    </div>

                    <div class="contact-information">

                        <div class="contact-item">

                            <span class="contact-label">
                                Persona encargada
                            </span>

                            <strong>
                                <%= vacante.reclutador || 'No especificada' %>
                            </strong>

                        </div>

                        <div class="contact-item">

                            <span class="contact-label">
                                Correo electrónico
                            </span>

                            <% if (vacante.contacto) { %>

                                <a href="mailto:<%= vacante.contacto %>">
                                    <%= vacante.contacto %>
                                </a>

                            <% } else { %>

                                <strong>No especificado</strong>

                            <% } %>

                        </div>

                    </div>

                </section>

            </div>


            <!-- COLUMNA LATERAL -->

            <aside class="detail-sidebar">


                <!-- TARJETA DE POSTULACIÓN -->

                <section class="application-card">

                    <span class="application-label">
                        OPORTUNIDAD LABORAL
                    </span>

                    <h2>¿Te interesa este empleo?</h2>

                    <p>
                        Da el siguiente paso en tu carrera profesional.
                        Consulta esta oportunidad y postúlate con tu perfil de TalentoHub.
                    </p>

                    <% if (!locals.usuarioActual) { %>
                        <a
                            href="/auth/login?volver=/busqueda/empleo/<%= vacante.id %>"
                            class="apply-button"
                            style="display: flex; justify-content: center; align-items: center; gap: 8px; text-decoration: none;"
                        >
                            Iniciar sesión para postularme
                            <span>→</span>
                        </a>
                        <p class="pending-message" style="margin-top: 10px;">
                            ¿No tienes cuenta? <a href="/auth/registro?rol=candidato" style="color: #38bdf8; font-weight: 700;">Regístrate como Aplicante</a>
                        </p>
                    <% } else if (usuarioActual.rol === 'candidato') { %>
                        <% if (postulacionActual) { %>
                            <div style="background: rgba(16, 185, 129, 0.18); border: 1px solid rgba(16, 185, 129, 0.45); color: #d1fae5; padding: 12px 14px; border-radius: 10px; margin-bottom: 12px; font-size: 13.5px;">
                                <strong>✓ Ya te postulaste a este empleo</strong><br>
                                Estado actual: <span style="text-transform: uppercase; font-weight: 800;"><%= postulacionActual.estado %></span>
                            </div>
                            <a href="/candidato" class="apply-button" style="display: flex; justify-content: center; text-decoration: none;">
                                Ver mi postulación en Mi Panel →
                            </a>
                        <% } else { %>
                            <form method="post" action="/busqueda/empleo/<%= vacante.id %>/postular" style="margin: 0;">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || locals.csrf || '' %>">
                                <button type="submit" class="apply-button">
                                    Postularme ahora como <%= usuarioActual.nombreMostrar %>
                                    <span>→</span>
                                </button>
                            </form>
                        <% } %>
                    <% } else if (usuarioActual.rol === 'empresa') { %>
                        <div style="background: rgba(255,255,255,0.1); padding: 12px; border-radius: 10px; font-size: 13px; margin-bottom: 12px;">
                            Estás navegando con la cuenta empresarial <strong><%= usuarioActual.nombreMostrar %></strong>.
                        </div>
                        <a href="/empresarial/vacantes" class="apply-button" style="display: flex; justify-content: center; text-decoration: none;">
                            Ir a mis vacantes empresariales →
                        </a>
                    <% } %>

                    <div class="application-divider"></div>

                    <button
                        type="button"
                        class="share-button"
                        onclick="compartirVacante()"
                    >
                        <span>↗</span>
                        Compartir vacante
                    </button>

                    <details style="margin-top: 12px; background: rgba(255,255,255,0.06); padding: 10px 12px; border-radius: 10px;">
                        <summary style="cursor: pointer; font-size: 13px; font-weight: 600; color: #fca5a5;">
                            🚩 Reportar irregularidad en esta vacante
                        </summary>
                        <form method="post" action="/busqueda/empleo/<%= vacante.id %>/reportar" style="margin-top: 10px; display: flex; flex-direction: column; gap: 8px;">
    <input type="hidden" name="_csrf" value="<%= locals.csrfToken || locals.csrf || '' %>">
                            <select name="motivo" aria-label="Motivo del reporte" required style="padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12.5px;">
                                <option value="">Selecciona motivo...</option>
                                <option value="Información salarial o requisitos engañosos">Información salarial o requisitos engañosos</option>
                                <option value="Oferta fraudulenta o cobro indebido">Oferta fraudulenta o cobro indebido</option>
                                <option value="Contenido discriminatorio o inapropiado">Contenido discriminatorio o inapropiado</option>
                                <option value="Vacante duplicada o spam">Vacante duplicada o spam</option>
                            </select>
                            <textarea name="descripcion" aria-label="Descripción del reporte" rows="2" placeholder="Describe el motivo (opcional)..." style="padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1; font-size: 12.5px;"></textarea>
                            <button type="submit" style="padding: 8px 12px; border-radius: 6px; background: #dc2626; color: #fff; border: none; font-weight: 700; cursor: pointer; font-size: 12.5px;">
                                Enviar reporte a Moderación
                            </button>
                        </form>
                    </details>

                </section>


                <!-- RESUMEN DEL EMPLEO -->

                <section class="detail-card summary-card">

                    <h3>Información del empleo</h3>

                    <div class="summary-item">

                        <span class="summary-icon">＄</span>

                        <div>
                            <span>Salario mensual</span>

                            <strong>

                                <% if (salarioMinimo !== null && salarioMaximo !== null) { %>

                                    $<%= salarioMinimo.toLocaleString('en-US') %>
                                    -
                                    $<%= salarioMaximo.toLocaleString('en-US') %>

                                <% } else if (salarioMinimo !== null) { %>

                                    Desde $<%= salarioMinimo.toLocaleString('en-US') %>

                                <% } else if (salarioMaximo !== null) { %>

                                    Hasta $<%= salarioMaximo.toLocaleString('en-US') %>

                                <% } else { %>

                                    No especificado

                                <% } %>

                            </strong>
                        </div>

                    </div>


                    <div class="summary-item">

                        <span class="summary-icon">✧</span>

                        <div>
                            <span>Experiencia</span>
                            <strong>
                                <%= vacante.experiencia || 'No especificada' %>
                            </strong>
                        </div>

                    </div>


                    <div class="summary-item">

                        <span class="summary-icon">▤</span>

                        <div>
                            <span>Tipo de contrato</span>
                            <strong>
                                <%= vacante.tipoContrato || 'No especificado' %>
                            </strong>
                        </div>

                    </div>


                    <div class="summary-item">

                        <span class="summary-icon">◷</span>

                        <div>
                            <span>Fecha de publicación</span>
                            <strong><%= fecha %></strong>
                        </div>

                    </div>


                    <div class="summary-item">

                        <span class="summary-icon">⌖</span>

                        <div>
                            <span>Ubicación</span>
                            <strong>
                                <%= vacante.ubicacion || 'No especificada' %>
                            </strong>
                        </div>

                    </div>

                </section>

            </aside>

        </div>


        <!-- =====================================
             EMPLEOS SIMILARES
        ====================================== -->

        <section class="similar-section">

            <div class="similar-heading">

                <div>
                    <span class="section-eyebrow">
                        MÁS OPORTUNIDADES
                    </span>

                    <h2>Empleos similares</h2>

                    <p>
                        Descubre otras oportunidades que podrían interesarte.
                    </p>
                </div>

                <a href="/busqueda" class="all-jobs-link">
                    Ver todas las vacantes →
                </a>

            </div>


            <% if (vacantesSimilares.length === 0) { %>

                <div class="similar-empty">
                    <p>
                        No hay otras vacantes similares disponibles por el momento.
                    </p>
                </div>

            <% } else { %>

                <div class="similar-grid">

                    <% vacantesSimilares.forEach(similar => { %>

                        <article class="similar-card">

                            <span class="similar-sector">
                                <%= similar.sector || 'Oportunidad laboral' %>
                            </span>

                            <h3><%= similar.titulo %></h3>

                            <p class="similar-company">
                                <%= similar.empresa %>
                            </p>

                            <div class="similar-meta">

                                <span>
                                    ⌖ <%= similar.ubicacion || 'No especificada' %>
                                </span>

                                <span>
                                    ◷ <%= similar.modalidad || 'No especificada' %>
                                </span>

                            </div>

                            <a href="/busqueda/empleo/<%= similar.id %>">
                                Consultar empleo
                                <span>→</span>
                            </a>

                        </article>

                    <% }) %>

                </div>

            <% } %>

        </section>


        <!-- VOLVER -->

        <div class="back-results">
            <a href="/busqueda">
                ← Volver a los resultados de búsqueda
            </a>
        </div>

    </main>


    <!-- =====================================
         PIE DE PÁGINA
    ====================================== -->

    <footer class="main-footer">

        <div class="footer-container">

            <a href="/" class="brand footer-brand">
                <span class="brand-icon">T</span>
                <span>Talento<span class="brand-highlight">Hub</span></span>
            </a>

            <p>
                Conectando talentos con nuevas oportunidades.
            </p>

            <span class="copyright">
                © <%= new Date().getFullYear() %> TalentoHub.
                Todos los derechos reservados.
            </span>

        </div>

    </footer>


    <!-- =====================================
         FUNCIONES DE LA PÁGINA
    ====================================== -->

    <script>

        // Compartir o copiar el enlace de la vacante.
        async function compartirVacante() {

            const enlace = window.location.href;

            try {

                if (navigator.share) {

                    await navigator.share({
                        title: document.title,
                        url: enlace
                    });

                } else if (navigator.clipboard) {

                    await navigator.clipboard.writeText(enlace);

                    alert('¡Enlace copiado correctamente!');

                } else {

                    prompt('Copia el enlace de esta vacante:', enlace);

                }

            } catch (error) {

                if (error.name !== 'AbortError') {
                    alert('No fue posible compartir la vacante.');
                }

            }

        }


        // Mensaje temporal de postulación.
        function mostrarMensajePostulacion() {

            const mensaje = document.getElementById('mensajePostulacion');

            mensaje.textContent =
                'La postulación estará disponible cuando implementemos el inicio de sesión y el registro de candidatos.';

            mensaje.classList.add('visible');

        }

    </script>

</body>
</html>
