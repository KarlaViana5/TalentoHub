<%- include('../modulo4/inicio', { titulo }) %>
<div class="panel-administrativo">
    <nav class="menu-admin" aria-label="Secciones administrativas">
        <a href="/administrativo" <%- pagina === 'panel' ? 'aria-current="page"' : '' %>>Panel y estadísticas</a>
        <% for (const [ruta, item] of Object.entries(menu)) { %>
            <a href="/administrativo/<%= ruta %>" <%- pagina === 'lista' && ruta === nombre ? 'aria-current="page"' : '' %>><%= item.titulo %></a>
        <% } %>
        <a href="/administrativo/configuracion" <%- pagina === 'configuracion' ? 'aria-current="page"' : '' %>>Configuración y avisos</a>
    </nav>
    <section class="contenido-admin">
        <h1><%= titulo %></h1>
        <% if (pagina === 'panel') { %><%- include('panel') %><% } %>
        <% if (pagina === 'lista') { %><%- include('lista') %><% } %>
        <% if (pagina === 'configuracion') { %><%- include('configuracion') %><% } %>
    </section>
</div>
<%- include('../modulo4/fin') %>
